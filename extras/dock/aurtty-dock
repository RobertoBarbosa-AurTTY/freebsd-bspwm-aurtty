#!/bin/sh
# aurtty-dock: dock embaixo com os ícones reais dos programas (Plank, sem fundo)
# freebsd-bspwm-aurtty
#
#   aurtty-dock iniciar    sobe a dock (se não estiver escondida pelo usuário)
#   aurtty-dock alternar   mostra/esconde (atalho super+d); a escolha é lembrada
#
# Ícones: terminal, Chrome, VS Code e IA local, só os que estiverem instalados.

OCULTA="$HOME/.config/aurtty/dock-oculta"
APPS=/usr/local/share/applications
LAUNCHERS="$HOME/.config/plank/dock1/launchers"
S="net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/"
ALTURA=62    # espaço que a dock ocupa embaixo (ícones de 52 px)

# O Plank reserva o espaço (strut) só depois de aparecer e o bspwm só lê isso quando a
# janela abre: sem ajustar o bottom_padding, as janelas cobririam a dock.
padding_do_tema() {
    rice=$(cat "$HOME/.config/bspwm/.rice" 2>/dev/null)
    v=$(sed -n 's/^BOTTOM_PADDING="\{0,1\}\([0-9]*\).*/\1/p' "$HOME/.config/bspwm/rices/$rice/theme-config.bash" 2>/dev/null | head -1)
    echo "${v:-1}"
}
espaco() { command -v bspc >/dev/null && bspc config bottom_padding "$1"; }

configurar() {
    mkdir -p "$LAUNCHERS"
    rm -f "$LAUNCHERS"/*.dockitem
    itens=""
    for d in Alacritty google-chrome code aurtty-ia; do
        [ -f "$APPS/$d.desktop" ] || continue
        printf '[PlankDockItemPreferences]\nLauncher=file://%s/%s.desktop\n' "$APPS" "$d" > "$LAUNCHERS/$d.dockitem"
        itens="$itens${itens:+, }'$d.dockitem'"
    done
    gsettings set "$S" dock-items "[$itens]"
    gsettings set "$S" theme 'Transparent'
    gsettings set "$S" position 'bottom'
    gsettings set "$S" alignment 'center'
    gsettings set "$S" hide-mode 'none'
    gsettings set "$S" icon-size 52
    gsettings set "$S" zoom-enabled true
    gsettings set "$S" zoom-percent 140
    gsettings set "$S" lock-items true
    gsettings set "$S" pinned-only true
    gsettings set "$S" show-dock-item false
}

iniciar() {
    if ! pgrep -qx plank; then
        configurar
        plank >/dev/null 2>&1 &
    fi
    espaco $(( $(padding_do_tema) + ALTURA ))
}

case ${1:-iniciar} in
    iniciar)
        [ -f "$OCULTA" ] || iniciar ;;
    alternar)
        if pgrep -qx plank; then
            pkill -x plank
            espaco "$(padding_do_tema)"
            mkdir -p "${OCULTA%/*}" && touch "$OCULTA"
        else
            rm -f "$OCULTA"
            iniciar
        fi ;;
    *)
        sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
